# Test Client 2 — throwaway isolated config for Week 5's second-brand
# onboarding simulation (US6). This directory proves the isolation boundary
# works: running `python -m worker bootstrap --env=clients/test-client-2/.env`
# must never read or write anything under the real repo root's SOUL.md,
# BRAND.md, HEARTBEAT.md, IDENTITY.md, or BOOTSTRAP.md.
#
# Copy to clients/test-client-2/.env and fill in what you use. Never commit .env.

# ─────────────────────────────────────────────
# CORE
# ─────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3001
BRAND_NAME=Test Client 2
SESSION_SECRET=
TZ=UTC

# ─────────────────────────────────────────────
# DATABASE — a second client gets its own Neon project/schema, never the
# first client's (docs/client-provisioning.md)
# ─────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────
# STORAGE — a second client gets its own R2 bucket, never the first client's
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
