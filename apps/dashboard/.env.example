# Copy to .env.local and fill in what you use. Never commit .env.local.
# Full variable reference: specs/002-week2-dashboard-render/contracts/env-vars.md

# ─────────────────────────────────────────────
# CORE
# ─────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
BRAND_NAME=                           # display name shown in the dashboard shell/title (Week 5, FR-016)
SESSION_SECRET=                       # openssl rand -hex 32
TZ=Asia/Karachi

# ─────────────────────────────────────────────
# DATABASE — Neon
# ─────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────
# STORAGE — Cloudflare R2
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=                            # e.g. yourbrand-social
R2_ENDPOINT=                          # https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=                        # e.g. https://media.yourbrand.com

# ─────────────────────────────────────────────
# RENDERING
# ─────────────────────────────────────────────
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1  -- only needed at npm install time, not runtime
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium  -- only set in Docker via docker-compose env
RENDER_INTERNAL_SECRET=

# ─────────────────────────────────────────────
# WORKER — dashboard → worker connection
# In Dokploy, each service has its own env, so WORKER_INTERNAL_URL
# on the dashboard points to the worker's internal service hostname.
# ─────────────────────────────────────────────
WORKER_INTERNAL_URL=http://localhost:8000  # Dokploy: worker's internal hostname, e.g. socialfte-worker-<suffix>:8000
NEXT_PUBLIC_RENDER_INTERNAL_SECRET=       # shared secret for /jobs/{id}/run — must match RENDER_INTERNAL_SECRET on worker

# ─────────────────────────────────────────────
# NOTIFICATION — Discord webhook signature verification
# ─────────────────────────────────────────────
DISCORD_PUBLIC_KEY=                   # from the Discord Developer Portal — verifies /api/webhooks/discord requests
