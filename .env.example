# Copy to .env (repo root) and fill in what you use. Never commit .env.

# ─────────────────────────────────────────────
# CORE
# ─────────────────────────────────────────────
NODE_ENV=production
APP_URL=                              # e.g. https://social.yourbrand.com
BRAND_NAME=                           # display name shown in the dashboard shell/title (Week 5, FR-016)
SESSION_SECRET=                       # openssl rand -hex 32
TZ=Asia/Karachi

# ─────────────────────────────────────────────
# DATABASE — Neon
# ─────────────────────────────────────────────
DATABASE_URL=
DATABASE_URL_UNPOOLED=
EMBED_DIMENSIONS=1536

# ─────────────────────────────────────────────
# REDIS — Upstash
# ─────────────────────────────────────────────
REDIS_URL=

# ─────────────────────────────────────────────
# STORAGE — Cloudflare R2
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=                            # e.g. yourbrand-social
R2_ENDPOINT=                          # https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=                        # e.g. https://media.yourbrand.com

# ─────────────────────────────────────────────
# META — Facebook Page + Instagram
# ─────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v25.0
META_TOKEN_REFRESH_DAYS=7

# ─────────────────────────────────────────────
# YOUTUBE
# ─────────────────────────────────────────────
YOUTUBE_CLIENT_SECRETS_PATH=/app/secrets/client_secrets.json
YOUTUBE_TOKEN_PATH=/app/secrets/token.json
YOUTUBE_CHANNEL_ID=
YOUTUBE_DEFAULT_CATEGORY=26
YOUTUBE_PRIVACY_ON_UPLOAD=private

# ─────────────────────────────────────────────
# TIKTOK
# ─────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_MODE=draft_only               # draft_only | direct_post

# ─────────────────────────────────────────────
# NOTIFICATION CHANNEL
# ─────────────────────────────────────────────
NOTIFY_CHANNEL=discord                # discord | whatsapp | telegram
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_CHANNEL_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────
# RENDERING
# ─────────────────────────────────────────────
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
RENDER_INTERNAL_URL=http://localhost:3000  # in Dokploy: the dashboard app's real internal hostname (check its panel — includes a random per-deployment suffix, e.g. socialfte-dashboard-2s66t5, not yl-dashboard)
RENDER_INTERNAL_SECRET=

# Brand payload compose_batch.py sends to /api/internal/render — colors/fonts
# should match packages/remotion/src/brand.ts and apps/dashboard/tailwind.config.ts.
BRAND_PRIMARY_COLOR=#1B4332
BRAND_ACCENT_COLOR=#C9A227
BRAND_LIGHT_COLOR=#F5F0E8
BRAND_DARK_COLOR=#1A1A1A
BRAND_MUTED_COLOR=#6b6b6b
BRAND_FONT_HEADING=Georgia, serif
BRAND_FONT_BODY=Helvetica, Arial, sans-serif
BRAND_LOGO_URL=                       # empty = no logo mark on posts
BRAND_SOCIAL_HANDLE=                  # e.g. @yousufliving — empty = not shown
BRAND_SHOW_MARK=true                  # toggle: logo + handle on posts/reels
CAPTION_LANGUAGE=                     # 'roman-urdu-english' | 'english' | 'urdu' — empty = skills/caption-writer.md's own default (Roman Urdu + English)

# ─────────────────────────────────────────────
# VIDEO RENDERING — GitHub Actions dispatch (Week 5)
# ─────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=                          # e.g. owner/socialfte
RENDER_WORKFLOW_FILE=render-video.yml
RENDER_WORKFLOW_REF=master            # branch render-video.yml dispatches against — must be a real branch/tag or GitHub 422s
RENDER_POLL_INTERVAL_SECONDS=30
RENDER_POLL_MAX_MINUTES=15
PROCESS_FOOTAGE_CRON=*/15 * * * *
MUSIC_BED_DB=-18
MUSIC_BED_ID=ambient-pad              # id from media/library/music/catalog.json
RETAG_ASSETS_CRON=0 */6 * * *         # catches assets whose upload-time vision-tag call failed
CREATE_CONCEPTS_CRON=0 6 * * 0        # generates headline/caption concepts for review on /concepts

# ─────────────────────────────────────────────
# PUBLISHING RULES (caps per platform per day)
# ─────────────────────────────────────────────
CAP_TIKTOK_PER_DAY=3
CAP_INSTAGRAM_PER_DAY=2
CAP_INSTAGRAM_STORIES_PER_DAY=5
CAP_FACEBOOK_PER_DAY=2
CAP_YOUTUBE_PER_DAY=1

# ─────────────────────────────────────────────
# WORKER
# ─────────────────────────────────────────────
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
WORKER_INTERNAL_URL=http://localhost:8000  # in Dokploy: the worker app's real internal hostname (check its panel — includes a random per-deployment suffix, e.g. socialfte-worker-2s66t5, not yl-worker)
SCHEDULER_TIMEZONE=Asia/Karachi
TOKEN_REFRESH_CRON=0 3 * * *
PUBLISH_DUE_CRON=*/15 * * * *
NOTIFY_REVIEW_CRON=30 4 * * *
NOTIFY_REVIEW_BATCH_LIMIT=10

# ─────────────────────────────────────────────
# LLM GATEWAY — OpenRouter (Week 4)
# ─────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=                  # e.g. https://social.yourbrand.com
OPENROUTER_APP_NAME=SocialFTE
MODEL_CAPTION=deepseek/deepseek-v4-flash-latest
MODEL_JUDGEMENT=deepseek/deepseek-v4-pro
MODEL_VISION=google/gemini-2.5-flash
MODEL_EMBED=openai/text-embedding-3-small
MODEL_FREE=openai/gpt-oss-20b:free    # see config.py's MODEL_FREE comment for other current free-tier alternatives
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120

# ─────────────────────────────────────────────
# ANTI-REPEAT (Week 4)
# ─────────────────────────────────────────────
ANTI_REPEAT_TEMPLATE_WINDOW=4
ANTI_REPEAT_ASSET_WINDOW=10
ANTI_REPEAT_CAPTION_WINDOW=30
ANTI_REPEAT_CAPTION_MAX_SIMILARITY=0.85
ANTI_REPEAT_MAX_RETRIES=5
IMAGE_POST_RATIO=0.7                  # fraction of Facebook/Instagram posts that get "image" format vs "video"; TikTok/YouTube always video

# ─────────────────────────────────────────────
# CRON SCHEDULES (Week 4)
# ─────────────────────────────────────────────
COMPOSE_BATCH_CRON=0 4 * * *          # daily at 04:00
COLLECT_METRICS_CRON=0 */6 * * *      # every 6 hours
WEEKLY_DIGEST_CRON=0 5 * * 0          # Sundays at 05:00
MEMORY_MD_PATH=MEMORY.md

# ─────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
