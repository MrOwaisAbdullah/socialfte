# SocialFTE worker — Python 3.13 + ffmpeg + uv.
# Build from the repo root: docker build -f infra/Dockerfile.worker .

FROM python:3.13-slim AS base

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# System deps: ffmpeg for video, libsndfile for audio processing
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    libsndfile1-dev \
    curl \
 && rm -rf /var/lib/apt/lists/*

# uv: copy static binary from official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency files first (Docker layer caching)
COPY apps/worker/pyproject.toml apps/worker/uv.lock ./

# `uv sync` (not `uv pip install`/`uv pip compile`) is what actually honors
# uv.lock's pinned versions — `uv pip compile pyproject.toml` re-resolves from
# pyproject.toml's loose version ranges at build time instead, silently
# defeating the whole point of committing a lockfile (the image could get
# different dependency versions than whatever was tested locally). `uv sync`
# has no `--system` flag (it always manages its own venv, by design) — so the
# venv lands at /app/.venv and gets put on PATH below instead.
# --frozen: fail rather than update the lock if it's out of sync with pyproject.toml.
# --no-dev: skip the dev-only dependency group (pytest, etc.) in the image.
RUN uv sync --frozen --no-dev
ENV PATH="/app/.venv/bin:$PATH"

# Copy worker code — every module uses bare absolute imports
# (`from config import settings`), so /app is the import root.
COPY apps/worker/ .

# Non-root user
RUN groupadd --system --gid 1001 worker \
 && useradd --system --uid 1001 --gid worker worker \
 && chown -R worker:worker /app

USER worker

# Worker is internal-only: no public port, docker network only.
# Health check for Docker/Dokploy.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
